<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SeduarApp.AdminDashboardPage"
             Title="Yönetici Paneli"
             BackgroundColor="#f5f5f5">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        
        <Label Text="Mağaza Yönetim Paneli" 
               FontSize="24" 
               FontAttributes="Bold" 
               TextColor="#2b2b2b" 
               HorizontalOptions="Center"
               Margin="0,0,0,10"/>

        <Button Text="📦 Yeni Ürün Ekle" 
                BackgroundColor="#2b2b2b" 
                TextColor="White" 
                CornerRadius="8"
                HeightRequest="50"
                Clicked="OnGoToAddProductClicked"/>

        <Button Text="🛍️ Gelen Siparişler (Yakında)" 
                BackgroundColor="#607D8B" 
                TextColor="White" 
                CornerRadius="8"
                HeightRequest="50"
                IsEnabled="False"/>

        <Button Text="🚪 Çıkış Yap" 
                BackgroundColor="#E53935" 
                TextColor="White" 
                CornerRadius="8"
                HeightRequest="50"
                Clicked="OnLogoutClicked"
                Margin="0,20,0,0"/>

    </VerticalStackLayout>
</ContentPage>