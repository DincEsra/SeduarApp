<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SeduarApp.AddProductPage"
             Title="Yeni Ürün Ekle"
             BackgroundColor="White">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Ürün Ekleme Paneli" FontSize="22" FontAttributes="Bold" TextColor="#2b2b2b" HorizontalOptions="Center"/>
            
            <Entry x:Name="NameEntry" Placeholder="Ürün Adı (örn: Deri Ceket)" TextColor="Black"/>
            <Editor x:Name="DescEditor" Placeholder="Ürün Açıklaması" HeightRequest="80" TextColor="Black"/>
            <Entry x:Name="PriceEntry" Placeholder="Fiyat (örn: 1499.99)" Keyboard="Numeric" TextColor="Black"/>
            <Entry x:Name="ImageEntry" Placeholder="Görsel URL (örn: https://...)" TextColor="Black"/>
            <Entry x:Name="CategoryEntry" Placeholder="Kategori (örn: KADIN / GİYİM)" TextColor="Black"/>
            
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <CheckBox x:Name="IsNewCheckBox"/>
                <Label Text="Yeni Gelenler (Yeni Ürün) olarak işaretle" VerticalTextAlignment="Center" TextColor="Black"/>
            </HorizontalStackLayout>
            
            <Button Text="Ürünü Veritabanına Kaydet" 
                    BackgroundColor="#2b2b2b" 
                    TextColor="White" 
                    CornerRadius="8"
                    Clicked="OnSaveClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>