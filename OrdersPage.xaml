<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SeduarApp.OrdersPage"
             Title="Siparişlerim"
             BackgroundColor="#f5f5f5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Geçmiş Siparişlerim" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="#2b2b2b" 
                   HorizontalOptions="Center"/>

            <!-- Sipariş Listesi -->
            <CollectionView x:Name="OrdersCollectionView" ItemsSource="{Binding OrderHistory}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White" CornerRadius="12" Padding="15" Margin="0,5" HasShadow="True">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="{Binding OrderId, StringFormat='Sipariş No: {0}'}" FontAttributes="Bold" FontSize="15" TextColor="#333"/>
                                    <Label Grid.Column="1" Text="{Binding OrderDate, StringFormat='{0:dd.MM.yyyy HH:mm}'}" FontSize="12" TextColor="Gray"/>
                                </Grid>
                                
                                <BoxView HeightRequest="1" Color="#eee"/>

                                <Label Text="{Binding Address, StringFormat='Adres: {0}'}" FontSize="13" TextColor="#555"/>
                                
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Toplam Tutar:" FontSize="14" TextColor="Gray"/>
                                    <Label Text="{Binding TotalAmount, StringFormat='₺{0:N2}'}" FontSize="14" FontAttributes="Bold" TextColor="#e91e63"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>