<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SeduarApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SeduarApp"
    Shell.FlyoutBehavior="Disabled">

    <!-- Alt menü metinlerini ve ikonlarını dikeyde hizalamak için Global Stil -->
    <Shell.Resources>
        <Style TargetType="TabBar">
            <!-- iOS ve Android için alt bar hizalama ayarları -->
            <Setter Property="Shell.ForegroundColor" Value="#e91e63"/>
        </Style>
    </Shell.Resources>

    <TabBar>
        <ShellContent Title="Ana Sayfa" 
                      Route="MainPage" 
                      ContentTemplate="{DataTemplate local:MainPage}" />
        
        <ShellContent Title="Sepetim" 
                      Route="CartPage" 
                      ContentTemplate="{DataTemplate local:CartPage}" />
        
        <ShellContent Title="Siparişlerim" 
                      Route="OrdersPage" 
                      ContentTemplate="{DataTemplate local:OrdersPage}" />
    </TabBar>

</Shell>