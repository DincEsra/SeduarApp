<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SeduarApp.MainPage"
             Title=""
             BackgroundColor="#f5f5f5">

    <!-- Sağ üst köşede görünecek sepet butonu ve sayacı -->
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="CartToolbarItem" 
                     Text="🛒 Sepet (0)" 
                     Clicked="OnCartIconClicked" />
    </ContentPage.ToolbarItems>

    <!-- Ana Yapı Grid (Satırlar: Başlık, Arama, Kategoriler, Ürün Listesi) -->
    <Grid RowDefinitions="Auto, Auto, Auto, *">
        
        <!-- 0. Uygulama Başlığı -->
        <Label Grid.Row="0"
               Text="Seduar" 
               FontSize="26" 
               FontAttributes="Bold" 
               TextColor="#2b2b2b" 
               HorizontalOptions="Center" 
               Margin="0,10,0,5"/>

        <!-- 1. Arama Çubuğu -->
        <SearchBar Grid.Row="1" 
                   x:Name="ProductSearchBar"
                   Placeholder="Ürün ara..." 
                   TextChanged="OnSearchBarTextChanged"
                   BackgroundColor="White"
                   Margin="10,0,10,5"/>

      <!-- 2. Kategori Filtreleme Butonları (Yatay Kaydırılabilir) -->
<ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="45" Margin="10,0,10,10">
    <HorizontalStackLayout x:Name="CategoryLayout" Spacing="8" VerticalOptions="Center">
        <Button Text="Tümü" BackgroundColor="#2b2b2b" TextColor="White" CornerRadius="8" HeightRequest="35" Clicked="OnCategoryFilterClicked" CommandParameter="Tümü"/>
        <Button Text="Çanta" BackgroundColor="#e0e0e0" TextColor="#333" CornerRadius="8" HeightRequest="35" Clicked="OnCategoryFilterClicked" CommandParameter="Çanta"/>
        <Button Text="Ayakkabı" BackgroundColor="#e0e0e0" TextColor="#333" CornerRadius="8" HeightRequest="35" Clicked="OnCategoryFilterClicked" CommandParameter="Ayakkabı"/>
        <Button Text="Aksesuar" BackgroundColor="#e0e0e0" TextColor="#333" CornerRadius="8" HeightRequest="35" Clicked="OnCategoryFilterClicked" CommandParameter="Aksesuar"/>
    </HorizontalStackLayout>
</ScrollView>

        <!-- 3. Ürün Listesi (CollectionView - Filtrelenmiş liste buraya bağlanır) -->
        <CollectionView Grid.Row="3" 
                        ItemsSource="{Binding FilteredProducts}" 
                        ItemSizingStrategy="MeasureAllItems"
                        Margin="10,0">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White" CornerRadius="12" Padding="10" Margin="0" HasShadow="True">
                        
                        <!-- İçeriği saran Grid'e tıklandığında detay sayfasına gider -->
                        <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProductTapped" CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                            
                            <!-- Ürün Görseli ve Kalp Butonu Aynı Hücrede -->
                            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                                <Image Source="{Binding ImageUrl}" 
                                       HeightRequest="120" 
                                       WidthRequest="120" 
                                       Aspect="AspectFill" 
                                       BackgroundColor="#f0f0f0"
                                       HorizontalOptions="Center"/>
                                
                                <!-- Favori Kalp Butonu -->
                                <Button Text="♡" 
                                        FontSize="18" 
                                        BackgroundColor="Transparent" 
                                        TextColor="#e91e63" 
                                        Clicked="OnFavoriteClicked"
                                        CommandParameter="{Binding .}"
                                        HorizontalOptions="End" 
                                        VerticalOptions="Start"
                                        Margin="0,0,5,0"/>
                            </Grid>

                            <!-- Kategori / Bilgi -->
                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Category}" FontSize="11" TextColor="Gray" Margin="0,5,0,0"/>
                            
                            <!-- Ürün Adı ve Fiyat -->
                            <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#333"/>
                            <Label Grid.Row="3" Grid.Column="0" Text="{Binding Price, StringFormat='₺{0:N2}'}" FontSize="15" FontAttributes="Bold" TextColor="#e91e63" VerticalOptions="Center"/>

                            <!-- Sepete Ekle Butonu -->
                            <Button Grid.Row="3" Grid.Column="1" 
                                    Text="Ekle" 
                                    Clicked="OnAddToCartClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#333333" 
                                    TextColor="White" 
                                    FontSize="12"
                                    HeightRequest="35"
                                    CornerRadius="8"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>